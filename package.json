{
  "name": "jobradar",
  "version": "1.0.0",
  "description": "AI-Powered Job Tracking System",
  "type": "module",
  "bin": {
    "jobradar": "./bin/jobradar.js"
  },
  "scripts": {
    "jobctl": "tsx scripts/command/index.ts",
    "test": "vitest run",
    "test:ai-eval": "vitest run --config vitest.eval.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "fig": {
    "jobctl": {
      "subcommands": [
        {
          "name": "scan",
          "description": "Scan jobs from ATS patterns"
        },
        {
          "name": "sync",
          "description": "Sync jobs from community sources"
        },
        {
          "name": "batch",
          "description": "Submit and collect cheaper batch analysis for queued jobs",
          "options": [
            {
              "name": "--submit-only",
              "description": "Submit queued jobs, then exit without waiting for results"
            }
          ]
        },
        {
          "name": "notify",
          "description": "Send notification emails",
          "subcommands": [
            {
              "name": "latest",
              "description": "Notify the latest stored jobs"
            },
            {
              "name": "range",
              "description": "Notify jobs in a date range",
              "args": [
                {
                  "name": "from"
                },
                {
                  "name": "to"
                }
              ]
            },
            {
              "name": "commit",
              "description": "Notify jobs from a commit",
              "args": {
                "name": "commit"
              }
            }
          ]
        },
        {
          "name": "setup",
          "description": "Check and print configuration",
          "subcommands": [
            {
              "name": "check-config",
              "description": "Check the local configuration"
            },
            {
              "name": "get-config",
              "description": "Print the local configuration"
            }
          ]
        },
        {
          "name": "job",
          "description": "Maintain stored jobs",
          "subcommands": [
            {
              "name": "add",
              "description": "Add jobs from links, a JSON file, or interactive prompts",
              "options": [
                {
                  "name": [
                    "-l",
                    "--link"
                  ],
                  "description": "Job URL. Repeat to add more than one",
                  "isRepeatable": true,
                  "exclusiveOn": [
                    "--file"
                  ],
                  "args": {
                    "name": "url"
                  }
                },
                {
                  "name": [
                    "-f",
                    "--file"
                  ],
                  "description": "JSON file of one Job or a Job array. Defaults to scripts/job.json",
                  "exclusiveOn": [
                    "--link"
                  ],
                  "args": {
                    "name": "jobs.json",
                    "isOptional": true,
                    "template": "filepaths"
                  }
                }
              ]
            },
            {
              "name": "analyze",
              "description": "Print JD analysis for URLs without storing jobs",
              "options": [
                {
                  "name": [
                    "-l",
                    "--link"
                  ],
                  "description": "Job URL. Repeat to analyze more than one",
                  "isRepeatable": true,
                  "args": {
                    "name": "url"
                  }
                }
              ]
            },
            {
              "name": "delete",
              "description": "Delete exact posting URLs from urls, companies, and opportunities",
              "options": [
                {
                  "name": [
                    "-l",
                    "--link"
                  ],
                  "description": "Exact posting URL. Repeat to delete more than one",
                  "isRepeatable": true,
                  "exclusiveOn": [
                    "--file"
                  ],
                  "args": {
                    "name": "url"
                  }
                },
                {
                  "name": [
                    "-f",
                    "--file"
                  ],
                  "description": "Text file with one exact URL per line",
                  "exclusiveOn": [
                    "--link"
                  ],
                  "args": {
                    "name": "urls.txt",
                    "template": "filepaths"
                  }
                }
              ]
            },
            {
              "name": "clean",
              "description": "Drop dead posting URLs and refresh companies"
            },
            {
              "name": "dedup",
              "description": "Deduplicate stored URLs and opportunities"
            }
          ]
        },
        {
          "name": "company",
          "description": "Maintain stored companies",
          "subcommands": [
            {
              "name": "refresh",
              "description": "Rebuild companies from stored URLs"
            }
          ]
        },
        {
          "name": "board",
          "description": "Publish the README, subpages, and badges",
          "subcommands": [
            {
              "name": "refresh",
              "description": "Regenerate the README, subpages, and badges"
            }
          ]
        },
        {
          "name": "email",
          "description": "Email tools",
          "subcommands": [
            {
              "name": "preview",
              "description": "Write preview.html for one stored job"
            }
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.41",
    "@types/nodemailer": "^7.0.11",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "inquirer": "^13.4.1",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@google/genai": "^1.43.0",
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "nodemailer": "^8.0.1",
    "openai": "^6.42.0",
    "p-limit": "^7.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  }
}
